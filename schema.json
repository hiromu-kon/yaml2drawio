{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/hiromu-kon/yaml2drawio/main/schema.json",
  "type": "object",
  "properties": {
    "title": {
      "description": "Name of the draw.io page.",
      "type": "string"
    },
    "direction": {
      "description": "How the children are laid out. Defaults to horizontal.",
      "type": "string",
      "enum": [
        "vertical",
        "horizontal"
      ]
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      },
      "description": "What the diagram contains."
    },
    "links": {
      "description": "Lines between ids.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Link"
      }
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false,
  "title": "yaml2drawio diagram",
  "definitions": {
    "Node": {
      "anyOf": [
        {
          "$ref": "#/definitions/Leaf"
        },
        {
          "$ref": "#/definitions/Group"
        },
        {
          "$ref": "#/definitions/Row"
        },
        {
          "$ref": "#/definitions/Column"
        }
      ],
      "description": "An icon, a group, a row or a column."
    },
    "Leaf": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
