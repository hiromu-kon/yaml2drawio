        "label": {
          "description": "Text under the icon. Defaults to the icon's title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "icon"
      ],
      "additionalProperties": false,
      "description": "An icon."
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique id, needed only to link to the group.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "group": {
          "type": "string",
          "description": "Group style, such as aws.vpc, aws.az or aws.private_subnet.",
          "enum": [
            "aws.account",
            "aws.asg",
            "aws.auto_scaling_group",
            "aws.availability_zone",
            "aws.aws_account",
            "aws.aws_cloud",
            "aws.aws_cloud_groups",
            "aws.aws_iot_greengrass",
            "aws.aws_iot_greengrass_deployment",
            "aws.aws_step_functions_workflow",
            "aws.az",
            "aws.cloud",
            "aws.cloud_plain",
            "aws.corporate_data_center",
            "aws.ec2_instance_contents",
            "aws.elastic_beanstalk_container",
            "aws.generic",
            "aws.generic_filled",
            "aws.generic_group",
            "aws.generic_group_groups",
            "aws.private_subnet",
            "aws.public_subnet",
            "aws.region",
            "aws.security_group",
            "aws.server_contents",
            "aws.spot_fleet",
            "aws.step_functions_workflow",
            "aws.vpc"
          ]
        },
        "label": {
          "description": "Title of the group. Defaults to the style's title.",
          "type": "string"
        },
        "direction": {
          "description": "How the children are laid out. Defaults to horizontal.",
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "align": {
          "description": "How the children line up across the direction. expand gives them all the same size. Defaults to center.",
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "expand"
          ]
        },
        "border": {
          "description": "Icons placed on the edge of the group, keyed by position (n, ne, e, ...).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "n",
              "nne",
              "ne",
              "ene",
              "e",
              "ese",
              "se",
              "sse",
              "s",
              "ssw",
              "sw",
              "wsw",
              "w",
              "wnw",
              "nw",
              "nnw"
            ]
          },
          "additionalProperties": {
            "$ref": "#/definitions/Leaf"
          }
        },
        "children": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          },
          "description": "What the group contains."
        }
      },
      "required": [
        "group",
        "children"
      ],
      "additionalProperties": false,
      "description": "A box around other nodes, such as a VPC or a subnet."
    },
    "Row": {
      "type": "object",
      "properties": {
        "align": {
          "description": "How the children line up across the direction. expand gives them all the same size. Defaults to center.",
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "expand"
          ]
        },
        "row": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          },
          "description": "Nodes laid out left to right."
        }
      },
      "required": [
        "row"
      ],
      "additionalProperties": false,
      "description": "Nodes laid out left to right without a box."
    },
    "Column": {
      "type": "object",
      "properties": {
        "align": {
          "description": "How the children line up across the direction. expand gives them all the same size. Defaults to center.",
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "expand"
          ]
        },
        "column": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          },
          "description": "Nodes laid out top to bottom."
        }
      },
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "description": "Nodes laid out top to bottom without a box."
    },
    "Link": {
      "anyOf": [
        {
          "type": "array",
          "items": [
            {
              "$ref": "#/definitions/Endpoint"
            },
            {
              "$ref": "#/definitions/Endpoint"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/definitions/Endpoint"
            },
            "to": {
              "$ref": "#/definitions/Endpoint"
            },
            "label": {
              "description": "Text on the line.",
              "type": "string"
            },
            "style": {
              "description": "Defaults to solid.",
              "type": "string",
              "enum": [
                "solid",
                "dashed"
              ]
            },
            "arrow": {
              "description": "Which ends get an arrowhead. Defaults to end.",
              "type": "string",
              "enum": [
                "end",
                "start",
                "both",
                "none"
              ]
            },
            "route": {
              "description": "auto bends the line in the gaps around groups; drawio leaves the whole route to draw.io. Defaults to auto.",
              "type": "string",
              "enum": [
                "auto",
                "drawio"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A line: [from, to], or an object for a label or style."
    },
    "Endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.(n|nne|ne|ene|e|ese|se|sse|s|ssw|sw|wsw|w|wnw|nw|nnw))?$",
      "description": "An id, optionally followed by the side the line leaves or enters, such as alb.s (n, ne, e, se, s, sw, w, nw and the points between them)."
    }
  }
}
